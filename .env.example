# Copier vers .env : copy .env.example .env

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings_prod
DJANGO_SECRET_KEY=generer-une-cle-aleatoire-50-caracteres-minimum
DJANGO_DEBUG=false
# Inclure l’IP ou le nom d’hôte utilisé dans le navigateur (sans le port)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,172.16.41.225
# Inclure le port si accès via http://IP:8010
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://172.16.41.225:8010
DJANGO_USE_HTTPS=false
DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=UTC

# --- Docker ---
WEB_PORT=8010
GUNICORN_WORKERS=2
# Arbor AED : ~2 Go+ en SCP — timeout worker Gunicorn (secondes, défaut 7200 = 2 h)
GUNICORN_TIMEOUT=7200
# Jobs « En cours » plus vieux que N minutes → marqués échoués au démarrage du conteneur
BACKUP_JOB_STALE_MINUTES=30
# Intervalle du service scheduler Docker (secondes)
BACKUP_SCHEDULER_INTERVAL_SECONDS=60
# Dossiers sur l'hôte montés dans les conteneurs (créer les répertoires avant le premier démarrage)
# Ex. Linux : /home/abourobodi/atos/vaultis et /home/abourobodi/atos/postgres
VAULTIS_HOST_DATA_DIR=./data
POSTGRES_HOST_DATA_DIR=./data/postgres
# Dossier monté en /app/secrets (fichiers mots de passe, non versionné)
VAULTIS_SECRETS_DIR=./secrets

# --- PostgreSQL (Docker : POSTGRES_HOST=db) ---
POSTGRES_DB=vaultis
POSTGRES_USER=vaultis
POSTGRES_PASSWORD=changer-mot-de-passe-postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://vaultis:changer-mot-de-passe-postgres@db:5432/vaultis

# --- Nitrokey / NetHSM ---
NITROKEY_INTEGRATION=nethsm
NITROKEY_NETHSM_VERIFY_TLS=true
# Identifiants API NetHSM par défaut (formulaire web : mode « identifiants par défaut »)
NITROKEY_NETHSM_USER=
NITROKEY_NETHSM_PASSWORD=
# NITROKEY_NETHSM_USER_FILE=/app/secrets/nethsm_username
# NITROKEY_NETHSM_PASSWORD_FILE=/app/secrets/nethsm_password
NITROKEY_BACKUP_ROOT=/app/data/backups/nitrokey
NITROKEY_TRANSFER_MODE=auto
# Optionnel : copie le .bkp après création locale vers un dossier de transfert (ex. montage SMB/CIFS)
NITROKEY_WINDOWS_TRANSFER_DIR=
# Optionnel (prioritaire) : transfert SMB direct vers un partage Windows distant
NITROKEY_WINDOWS_SMB_HOST=
NITROKEY_WINDOWS_SMB_SHARE=
NITROKEY_WINDOWS_SMB_REMOTE_DIR=
NITROKEY_WINDOWS_SMB_USERNAME=
NITROKEY_WINDOWS_SMB_PASSWORD=
NITROKEY_WINDOWS_SMB_DOMAIN=
NITROKEY_WINDOWS_SMB_PORT=445
# Optionnel : transfert SCP direct vers un hôte Windows avec OpenSSH
NITROKEY_WINDOWS_SCP_HOST=
NITROKEY_WINDOWS_SCP_PORT=22
NITROKEY_WINDOWS_SCP_USERNAME=
# NITROKEY_WINDOWS_SCP_USERNAME_FILE=/app/secrets/scp_username
# Mot de passe : guillemets doubles si # ou espaces — ex. NITROKEY_WINDOWS_SCP_PASSWORD="abc#def"
# Si les guillemets ne suffisent pas (Docker tronque au #), utiliser l’un des deux :
#   echo -n 'abc#def' | base64  →  NITROKEY_WINDOWS_SCP_PASSWORD_B64=...
#   printf '%s' 'abc#def' > secrets/scp_password  →  NITROKEY_WINDOWS_SCP_PASSWORD_FILE=...
NITROKEY_WINDOWS_SCP_PASSWORD=
# NITROKEY_WINDOWS_SCP_PASSWORD_B64=
# Chemins dans le conteneur (pas sur l'hôte) — montage ./secrets → /app/secrets
# NITROKEY_WINDOWS_SCP_PASSWORD_FILE=/app/secrets/scp_password
NITROKEY_WINDOWS_SCP_REMOTE_DIR=E:/NetConfig_Backup

# --- Arbor AED (DDOS) — classement fichiers + SCP (pas d'API) ---
# DC à traiter à chaque sauvegarde (virgules) : un seul ou les deux
ARBOR_AED_ACTIVE_DCS=DC01,DC02
# Incoming par DC — les 4 lignes ci-dessous sont obligatoires si le DC est actif :
#   SOURCE_HOST_* = chemin sur le serveur Linux (bind mount Docker)
#   SOURCE_DIR_*  = chemin dans le conteneur (lu par Django, aligné sur docker-compose)
ARBOR_AED_SOURCE_HOST_DC01=/home/mdoman/net-backups
ARBOR_AED_SOURCE_DIR_DC01=/app/arbor/incoming/dc01
ARBOR_AED_SOURCE_HOST_DC02=/home/mdoman/net-backups
ARBOR_AED_SOURCE_DIR_DC02=/app/arbor/incoming/dc02
# Dossier mère distant (VM Windows) par DC : {REMOTE}/YYYY-MM-DD/full|inc/
ARBOR_AED_REMOTE_PARENT_DIR_DC01=E:/NetConfig_Backup/ArborAED/DC01
ARBOR_AED_REMOTE_PARENT_DIR_DC02=E:/NetConfig_Backup/ArborAED/DC02
# Rétrocompat (un seul incoming pour les deux DC) :
# ARBOR_AED_SOURCE_DIR=/app/data/arbor/incoming
# ARBOR_AED_STAGING_DIR=/app/data/backups/arbor_aed/staging
# ARBOR_AED_MOVE_SOURCE=false
# Droits : les fichiers Arbor (souvent 600, uid 1003) doivent être lisibles par le conteneur (uid 1000).
# Sur l'hôte après chaque dépôt : find .../net-backups -type f -exec chmod 644 {} \;
# SCP : laisser vide pour réutiliser NITROKEY_WINDOWS_SCP_* ci-dessus
# ARBOR_AED_SCP_HOST=
# ARBOR_AED_SCP_PORT=22
# ARBOR_AED_SCP_USERNAME=
# ARBOR_AED_SCP_PASSWORD_FILE=/app/secrets/scp_password

# Hors Docker (SQLite) : ne pas définir DATABASE_URL ni POSTGRES_HOST
# DJANGO_DATABASE_PATH=./db.sqlite3
# NITROKEY_BACKUP_ROOT=./backups/nitrokey
