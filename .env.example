# Copier vers .env : copy .env.example .env

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings_prod
DJANGO_SECRET_KEY=generer-une-cle-aleatoire-50-caracteres-minimum
DJANGO_DEBUG=false
# Inclure l’IP ou le nom d’hôte utilisé dans le navigateur (sans le port)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,172.16.41.225
# Inclure le port si accès via http://IP:8010
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://172.16.41.225:8010
DJANGO_USE_HTTPS=false
DJANGO_LOG_LEVEL=INFO

# --- Docker ---
WEB_PORT=8010
GUNICORN_WORKERS=2

# --- PostgreSQL (Docker : POSTGRES_HOST=db) ---
POSTGRES_DB=vaultis
POSTGRES_USER=vaultis
POSTGRES_PASSWORD=changer-mot-de-passe-postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://vaultis:changer-mot-de-passe-postgres@db:5432/vaultis

# --- Nitrokey / NetHSM ---
NITROKEY_INTEGRATION=nethsm
NITROKEY_NETHSM_VERIFY_TLS=true
NITROKEY_NETHSM_USER=
NITROKEY_NETHSM_PASSWORD=
NITROKEY_BACKUP_ROOT=/app/data/backups/nitrokey

# Hors Docker (SQLite) : ne pas définir DATABASE_URL ni POSTGRES_HOST
# DJANGO_DATABASE_PATH=./db.sqlite3
# NITROKEY_BACKUP_ROOT=./backups/nitrokey
